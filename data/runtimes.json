  "agent_rule": "Anything acting as an agent has a PKI key and either write access to git (L4) or the ability to create and consume vaults (L2). A chat-only helper (L0) is a tool used by a person, not an agent.",
  "formula": {
    "place": "the cheapest (r, m) such that io(r) >= io(t), loop(r) contains loop(t), identity(r) >= identity(t), trust(r, m) >= data(t), capability(m) >= judgement(t), reach(r) contains network(t), latency(r, m) <= time(t), oversight(r) >= oversight(t)",
    "cost": "quota_pressure(r) x tokens(t) x price(m)",
    "calls": "inside an agent, model(c) = the cheapest tier whose capability >= difficulty(c), through admin/tools/llm.mjs; M3 when the data is private or the volume large and latency does not matter"
  },
