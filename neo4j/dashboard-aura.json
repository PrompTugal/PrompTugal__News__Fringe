          "y": 0,
          "meta": {},
          "settings": {
            "type": "graph",
            "query": "MATCH p = (:Span)-[:IS_CHILD_OF]->(:Span) RETURN p",
            "databaseName": "neo4j",
            "version": 2,
            "layout": {
              "type": "d3Force"
            },
            "graphStyleRules": []
          }
        },
        {
          "version": 1,
          "title": "Spans by flow and altitude",
          "w": 4,
          "h": 3,
          "x": 8,
          "y": 0,
          "meta": {},
          "settings": {
            "type": "table",
            "query": "MATCH (s:Span) RETURN s.flow AS flow, s.altitude AS altitude, count(s) AS spans, max(s.duration_ms) AS longest_ms, sum(CASE WHEN s.finished THEN 0 ELSE 1 END) AS unfinished ORDER BY flow, altitude",
            "databaseName": "neo4j",
            "actions": [],
            "version": 1,
            "richRenderCells": false,
            "compact": false,
            "dataGridStyleRules": []
          }
        }
