        "type": "keyword"
      },
      "tags": {
        "type": "keyword"
      },
      "n": {
        "type": "long"
      },
      "files": {
        "type": "long"
      },
      "words": {
        "type": "long"
      },
      "cost_usd": {
        "type": "double"
      },
      "duration_s": {
        "type": "double"
