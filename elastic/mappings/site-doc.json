      },
      "signer": {
        "type": "keyword"
      },
      "commit": {
        "type": "keyword"
      },
      "ingested_at": {
        "type": "date"
      },
      "ingested_by": {
        "type": "keyword"
      },
      "id": {
        "type": "keyword"
      },
      "path": {
        "type": "keyword"
      },
      "dir": {
        "type": "keyword"
      },
      "area": {
        "type": "keyword"
      },
      "type": {
        "type": "keyword"
      },
      "url": {
        "type": "keyword"
      },
      "status": {
        "type": "keyword"
      },
      "state": {
        "type": "keyword"
      },
      "outcome": {
        "type": "keyword"
